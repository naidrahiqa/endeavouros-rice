{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "/home/naidrahiqa/.config/fastfetch/castorice_pin.jpeg",
        "width": 40,
        "height": 20,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  ➜  ",
        "color": {
            "keys": "magenta",
            "title": "blue"
        }
    },
    "modules": [
        "break",
        "title",
        {
            "type": "separator",
            "string": "────────────────────────────"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "35"
        },
        {
            "type": "kernel",
            "key": "  Kernel",
            "keyColor": "34"
        },
        {
            "type": "packages",
            "key": "  Packages",
            "keyColor": "35"
        },
        {
            "type": "shell",
            "key": "  Shell",
            "keyColor": "34"
        },
        {
            "type": "de",
            "key": "  DE",
            "keyColor": "35"
        },
        {
            "type": "wmtheme",
            "key": "  Theme",
            "keyColor": "34"
        },
        {
            "type": "terminal",
            "key": "  Term",
            "keyColor": "35"
        },
        {
            "type": "font",
            "key": "  Font",
            "keyColor": "34"
        },
        "break",
        {
            "type": "cpu",
            "key": "  CPU",
            "keyColor": "33"
        },
        {
            "type": "gpu",
            "key": "  GPU",
            "keyColor": "33"
        },
        {
            "type": "memory",
            "key": "  RAM",
            "keyColor": "33"
        },
        {
            "type": "swap",
            "key": "  Swap",
            "keyColor": "33"
        },
        {
            "type": "disk",
            "key": "  Root",
            "keyColor": "33",
            "folders": "/"
        },
        {
            "type": "disk",
            "key": "  Data",
            "keyColor": "33",
            "folders": "/mnt/data"
        },
        {
            "type": "battery",
            "key": "  Battery",
            "keyColor": "33"
        },
        {
            "type": "uptime",
            "key": "  Up",
            "keyColor": "33"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break"
    ]
}
