{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "bg": "#1E1E2E",
    "fg": "#CDD6F4",
    "pink": "#F0D0D0",
    "yellow": "#F0E8C8",
    "green": "#C8E8C8",
    "blue": "#C0D8F0",
    "purple": "#D8C8E8",
    "peach": "#F0D8C8",
    "gray": "#6C7086"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:purple",
          "template": " "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\uE0B4",
          "foreground": "#3B3D5C",
          "background": "p:purple",
          "template": " {{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\uE0B4",
          "foreground": "#5C3D4D",
          "background": "p:pink",
          "properties": {
            "folder_icon": "\uF07B",
            "home_icon": "\uF015",
            "style": "agnoster_short"
          },
          "template": "  {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\uE0B4",
          "foreground": "#3D5C4D",
          "background": "p:green",
          "properties": {
            "branch_icon": "\uE725",
            "commit_icon": "\uF417",
            "fetch_status": false
          },
          "template": "  {{ .HEAD }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "template": "\uE0B4"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:blue",
          "template": "\u276F "
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
